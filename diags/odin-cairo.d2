# odin-cairo: its place in the binding graph
# Render:  d2 diags/odin-cairo.d2 diags/odin-cairo.svg

direction: down

title: "odin-cairo" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-cairo\ncairo 1.18.0" {
  style.fill: "#eef6ff"
}
lib: "cairo (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"cairo:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection cairo
this -> lib: foreign import
